@startuml
title Sistema de Reservas - Diagrama de Actividad

|Cliente|

start

:Solicitar reserva;
:Ingresar datos de reserva;
note right
  Fecha
  Tipo: almuerzo/cena
  Ubicación
  Tamaño de mesa
end note

|Sistema|

:Verificar cliente registrado;

if (¿Cliente registrado?) then (No)
    :Rechazar reserva;
    stop
else (Sí)
endif

:Verificar si el cliente está apto para reservar;

if (¿Tiene sanciones?) then (Sí)
    :Rechazar reserva;
    stop
else (No)
endif

:Verificar horario límite;

if (¿Está dentro del horario permitido?) then (No)
    :Rechazar reserva;
    stop
else (Sí)
endif

:Verificar disponibilidad de mesa;

if (¿Hay mesa disponible?) then (No)
    :Informar que no hay disponibilidad;
    stop
else (Sí)
endif

:Registrar reserva;
:Asignar mesa;
:Informar reserva confirmada;

|Cliente|

:Recibir confirmación;

|Sistema|

:Esperar fecha y hora de la reserva;

if (¿Cliente se presenta dentro de 30 minutos?) then (Sí)
    :Mantener reserva;
    :Marcar mesa como ocupada;
else (No)
    :Cancelar reserva;
    :Liberar mesa;
    :Registrar penalización;
    :Bloquear reservas online durante 1 semana;
endif

stop


|Recepcionista|

start

:Esperar hora de cierre de reservas;

if (¿Es almuerzo?) then (Sí)
    :Esperar hasta las 11:30 hs;
else (No)
    :Esperar hasta las 19:30 hs;
endif

:Generar reporte;

fork
    :Listar mesas asignadas;
    :Indicar cliente asignado a cada mesa;
fork again
    :Listar mesas disponibles;
end fork

:Entregar/consultar reporte;

stop

@enduml